# openpay.id configuration. Copy to .env and adjust.
# Every variable is optional except the database URL.

# --- General ---------------------------------------------------------------
OPENPAY_ENV=development
OPENPAY_LOG_LEVEL=info

# --- Servers ---------------------------------------------------------------
# API interface (merchant-facing).
OPENPAY_API_ADDR=:8080
# Webhook engine (gateway-facing).
OPENPAY_WEBHOOK_ADDR=:8081
OPENPAY_SHUTDOWN_TIMEOUT=15s

# --- Database --------------------------------------------------------------
OPENPAY_DATABASE_URL=postgres://openpay:openpay@localhost:5432/openpay?sslmode=disable
OPENPAY_MIGRATIONS_DIR=migrations
# Host port for the bundled docker-compose PostgreSQL (change if 5432 is taken).
OPENPAY_PG_PORT=5432

# --- Security --------------------------------------------------------------
# Optional pepper mixed into API-key hashing. Set it in production and keep it
# stable: changing it invalidates all stored API-key hashes.
OPENPAY_API_KEY_PEPPER=

# --- Providers -------------------------------------------------------------
# Comma separated list of providers to enable at startup. Each name must have a
# registered factory (see pkg/provider). The mock provider ships in-tree.
OPENPAY_PROVIDERS=mock

# Per-provider configuration is read from OPENPAY_PROVIDER_<NAME>_<KEY>.
# Keys are lower-cased and handed to the provider factory as provider.Config.
OPENPAY_PROVIDER_MOCK_SECRET=mock-secret
OPENPAY_PROVIDER_MOCK_VA_PREFIX=88888
OPENPAY_PROVIDER_MOCK_DEFAULT_EXPIRY=24h

# Example of a real gateway would look like:
# OPENPAY_PROVIDER_MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
# OPENPAY_PROVIDER_MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com

# --- Midtrans (Core API) ---------------------------------------------------
# The midtrans adapter ships in-tree and covers Virtual Accounts, QRIS,
# e-wallets (GoPay/ShopeePay), over-the-counter (Alfamart/Indomaret), Akulaku
# pay-later and card (via a frontend token). Keys:
#   server_key      Midtrans server key (required): "SB-Mid-server-..." on
#                   sandbox, "Mid-server-..." in production
#   base_url        https://api.sandbox.midtrans.com (default) or
#                   https://api.midtrans.com for production
#   callback_url    this platform's public callback URL, appended per charge via
#                   X-Append-Notification, e.g.
#                   https://openpay.example/webhooks/midtrans
#   default_expiry  default lifetime for VAs / retail outlets (default 24h)
#   timeout         per-request HTTP timeout (default 30s)
#
# OPENPAY_PROVIDERS=mock,midtrans
# OPENPAY_PROVIDER_MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
# OPENPAY_PROVIDER_MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
# OPENPAY_PROVIDER_MIDTRANS_CALLBACK_URL=https://openpay.example/webhooks/midtrans

# --- Winpay (SNAP API) -----------------------------------------------------
# The winpay adapter ships in-tree as a real-world example. Keys:
#   partner_id    X-PARTNER-ID issued by Winpay (required)
#   private_key   your RSA private key: a PEM block or single-line base64 DER
#   public_key    Winpay's RSA public key, for verifying callbacks
#   base_url      sandbox (default) or https://snap.winpay.id for production
#   callback_url  this platform's public callback URL (used as the eWallet
#                 PAY_NOTIFY url), e.g. https://openpay.example/webhooks/winpay
#   channel_id    CHANNEL-ID header value (default WEB)
#
# OPENPAY_PROVIDERS=mock,winpay
# OPENPAY_PROVIDER_WINPAY_PARTNER_ID=962489e9-de5d-4eb7-92a4-b07d44d64bf4
# OPENPAY_PROVIDER_WINPAY_PRIVATE_KEY=MIIEowIBAAKCAQB5jAWUddv1tZW6...
# OPENPAY_PROVIDER_WINPAY_PUBLIC_KEY=MIGeMA0GCSqGSIb3DQEBAQUAA4GMADCBiAKBgHGK...
# OPENPAY_PROVIDER_WINPAY_BASE_URL=https://sandbox-snap.winpay.id
# OPENPAY_PROVIDER_WINPAY_CALLBACK_URL=https://openpay.example/webhooks/winpay

# --- Outbound merchant webhooks -------------------------------------------
OPENPAY_WEBHOOK_TIMEOUT=10s
OPENPAY_WEBHOOK_MAX_ATTEMPTS=6
OPENPAY_WEBHOOK_BASE_BACKOFF=5s
OPENPAY_WEBHOOK_MAX_BACKOFF=5m
OPENPAY_WEBHOOK_WORKER_INTERVAL=5s
